<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for the LanguageTool Home Assistant app. Same as the image's
     logback.xml, but the HTTP handler only logs warnings and errors. Without
     this, the health check every 30 seconds adds two log lines and pushes the
     useful lines out of Home Assistant's log view. Checks are still logged by
     the text checker. -->
<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS ZZZZ} %-5level %logger %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="METRICS" class="org.languagetool.server.InstrumentedAppender" />

  <logger name="org.languagetool" level="INFO"/>
  <logger name="org.languagetool.server.LanguageToolHttpHandler" level="WARN"/>

  <root level="info">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="METRICS" />
  </root>
</configuration>
